{
  "name": "@go-ios/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the go-ios REST server (unary + typed SSE streaming).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "go-ios",
    "ios",
    "sdk",
    "sse",
    "openapi",
    "wda",
    "xcuitest"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "2.27.11",
    "@hey-api/openapi-ts": "0.64.13",
    "@types/node": "^22.20.1",
    "tsup": "8.3.5",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.10.2"
  }
}
