# The root .gitignore ignores `generated/` globally. For this package the
# generated low-level client IS committed (so the published package is
# self-contained and reproducible); re-negate it here. Regenerate with
# `npm run generate` after spec changes.
!src/generated/
!src/generated/**

# Artifact written by examples/04-screenshot.ts when run against a device.
screenshot.png
