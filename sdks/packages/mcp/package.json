{
  "name": "@go-ios/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for go-ios — let autonomous agents control iOS devices through the go-ios REST daemon.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/danielpaulus/go-ios/tree/main/sdks/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielpaulus/go-ios.git",
    "directory": "sdks/packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/danielpaulus/go-ios/issues"
  },
  "keywords": [
    "ios",
    "go-ios",
    "mcp",
    "model-context-protocol",
    "wda",
    "webdriveragent",
    "ui-automation",
    "device-automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "go-ios-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "npm run build && tsx examples/run-all.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
