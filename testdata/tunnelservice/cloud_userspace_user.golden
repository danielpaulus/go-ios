Name: go-ios-tunnel
DisplayName: go-ios tunnel agent
Description: go-ios tunnel agent (ios tunnel start) providing tunnels for iOS 17+ devices
Executable: /usr/local/bin/ios
Arguments: tunnel start --pair-record-path=/home/operator/records --userspace
WorkingDirectory: /home/operator
Option.Restart: always
Option.RunAtLoad: true
Option.UserService: true
Env.GO_IOS_AGENT_HOST: 0.0.0.0
Env.GO_IOS_AGENT_PORT: 60106
Env.ORCHESTRATOR_URL: https://orchestrator.example.com
Env.USBMUXD_SOCKET_ADDRESS: UNIX:///var/run/usbmuxd
